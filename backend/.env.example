# ==========================================
# PLATFORM CONFIG
# ==========================================
PORT=5000
NODE_ENV=production

# ==========================================
# DATABASE
# ==========================================
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_NAME=School_Management
DB_PORT=5432
DB_SSL=false

# ==========================================
# SECURITY
# ==========================================
JWT_SECRET=generate_a_long_random_secret_here
ENCRYPTION_KEY=32_byte_key_here

# ==========================================
# SMS PROVIDER
# ==========================================
SMS_API_URL=""
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID=""

# ==========================================
# WHATSAPP CLOUD API
# ==========================================
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_ENABLED=false
